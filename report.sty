% Original headheight + headsep = 24pt; reserve 17pt for its double-rule header.
\setlength{\headheight}{17pt}
\setlength{\headsep}{7pt}
\setlength{\footskip}{24pt}

% Body-page running header and footer.
\fancypagestyle{report}{%
