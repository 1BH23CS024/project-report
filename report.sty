% Custom contents rows resolve their numbers, titles and page ranges from labels.
\newcommand{\PageRange}[2]{%
  \begingroup
    \edef\firstpage{\getpagerefnumber{#1}}%
    \edef\lastpage{\getpagerefnumber{#2}}%
    \pageref{#1}\ifx\firstpage\lastpage\else--\pageref{#2}\fi
  \endgroup
}
\newcommand{\ContentsTitleX}{156.14}
\newcommand{\ContentsNumberX}{117.86}
\newcommand{\ContentsRow}[3]{%
  \FrontLineRaw{\ContentsTitleX}{\ContentsY{#1}}{0}{12}{\ref{#2}\ \nameref{#2}}%
  \FrontLineRaw{456.34}{\ContentsY{#1}}{30}{12}{\hfill\PageRange{#2}{#3}\hfill}%
}
\newcommand{\ContentsChapter}[3]{%
  \FrontLineRaw{\ContentsNumberX}{\ContentsY{#1}}{0}{12}{\textbf{\ref{#2}}}%
  \FrontLineRaw{\ContentsTitleX}{\ContentsY{#1}}{0}{12}{\textbf{\nameref{#2}}}%
  \FrontLineRaw{456.34}{\ContentsY{#1}}{30}{12}{\hfill\textbf{\PageRange{#2}{#3}}\hfill}%
}

