\renewcommand{\footrule}{{\color{red}\hrule height.5pt\vskip1pt\hrule height1pt}}

% Heading hierarchy and spacing.
\titleformat{\chapter}[display]{}%
  {\fontsize{16pt}{0pt}\selectfont\bfseries\chaptername\ \thechapter}{0pt}%
  {\centering\fontsize{18pt}{0pt}\selectfont\bfseries}
\titleformat{\section}{\fontsize{16pt}{0pt}\selectfont\bfseries}{\thesection}{1em}{}
\titleformat{\subsection}{\fontsize{14pt}{14pt}\selectfont\bfseries}{\thesubsection}{1em}{}
\titlespacing{\chapter}{0pt}{-12pt}{12pt}
\patchcmd{\chapter}{\thispagestyle{plain}}{\thispagestyle{report}}{}{}

% Put hyperlink anchors inside the heading line, after any automatic page break.
\makeatletter
% The current LaTeX kernel creates targets directly, bypassing titlesec's old hook.
\def\ttl@Hy@refstepcounter#1{%
  \H@refstepcounter{#1}\hyper@makecurrent{#1}%
  \def\ttl@Hy@saveanchor{\MakeLinkTarget{#1}}
}
\let\report@anchor\@empty
\patchcmd{\ttl@select}{\ttl@Hy@saveanchor}{\global\let\report@anchor\ttl@Hy@saveanchor}{}%
  {\PackageError{report}{Cannot defer heading anchors}{Check the titlesec version.}}
\pretocmd{\ttl@strut}{\report@anchor\global\let\report@anchor\@empty}{}{}
\makeatother

% Front matter is a measured, editable transcription of the Word-format pages.
% Coordinates are PDF points (bp), measured from the top-left of A4.
% Fixed artwork/headings preserve the college template; prose uses paragraph blocks.
\newenvironment{frontpage}{%
  \null\phantomsection
  \begin{tikzpicture}[remember picture,overlay]
    \draw[line width=3bp] ($(current page.north west)+(67bp,-41.05bp)$)
      rectangle ($(current page.north west)+(546.5bp,-819.01bp)$);
    \draw[line width=.72bp] ($(current page.north west)+(69.58bp,-43.63bp)$)
      rectangle ($(current page.north west)+(543.92bp,-816.43bp)$);
}{%
  \end{tikzpicture}\clearpage
}

\newsavebox{\frontlinebox}
\newcommand{\FrontLineRaw}[5]{%
  \node[anchor=base west,inner sep=0pt,outer sep=0pt]
    at ($(current page.north west)+(#1bp,-#2bp)$)
    {\fontsize{#4bp}{#4bp}\selectfont\hbadness=10000
      \ifdim#3bp=0bp\makebox[0pt][l]{#5}\else
        \sbox{\frontlinebox}{#5}%
        \ifdim\wd\frontlinebox>#3bp
          \resizebox{#3bp}{\height}{\usebox{\frontlinebox}}%
        \else
          \spaceskip=.25em plus1fil\makebox[#3bp][s]{#5}%
        \fi
      \fi};
}

% First-line baseline in bp; normal 12pt text with 18pt (1.5) line spacing.
\newcommand{\FrontParagraphRaw}[2]{%
  \node[anchor=base west,inner sep=0pt,outer sep=0pt]
    at ($(current page.north west)+(90bp,-#1bp)$)
    {\begin{minipage}[t]{\textwidth}
      \setstretch{1}\fontsize{12pt}{18pt}\selectfont
      \setlength{\parskip}{8pt}\emergencystretch=2em
      #2\par
    \end{minipage}};
}

\newcommand{\FrontImage}[5]{%
  \node[anchor=north west,inner sep=0pt,outer sep=0pt]
    at ($(current page.north west)+(#1bp,-#2bp)$)
    {\includegraphics[width=#3bp,height=#4bp]{#5}};
}
\newcommand{\FrontRect}[5]{%
  \draw[line width=#5bp] ($(current page.north west)+(#1bp,-#2bp)$)
    rectangle ($(current page.north west)+(#3bp,-#4bp)$);
}
\newcommand{\FrontRuleRaw}[4]{%
  \fill ($(current page.north west)+(#1bp,-#2bp)$)
    rectangle ($(current page.north west)+(#3bp,-#4bp)$);
}

% Front-page source files use named placements.  The measured coordinates live
